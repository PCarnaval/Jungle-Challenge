# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
HTTP_PORT=3000
# Qual processo esta instância executa: api | consumer | outbox | pending-reference | all
WORKER=all
LOG_LEVEL=info

# ---- Autenticação (HTTP) ---------------------------------------------------
# none = o AuthGuard é transparente (padrão, mantém dev/testes simples).
# hmac = toda requisição protegida precisa levar X-Provider-Id / X-Timestamp / X-Signature.
AUTH_MODE=hmac
# Objeto JSON { providerId: sharedSecret }. Obrigatório quando AUTH_MODE=hmac.
# PROVIDER_SECRETS={"provider-a":"troque-por-um-segredo-longo-e-aleatorio"}
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300

# ---- PostgreSQL -------------------------------------------------------------
DATABASE_URL=postgres://wager:wager@localhost:5432/wager
DB_POOL_MIN=2
DB_POOL_MAX=10
# statement_timeout aplicado às transações financeiras (ms)
DB_STATEMENT_TIMEOUT_MS=5000

# ---- AWS SQS via LocalStack ----------------------------------------------
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# ---- Consumer ----------------------------------------------------------------
CONSUMER_NAME=wager-consumer-1
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=30
SQS_MAX_RECEIVE_COUNT=5

# ---- Outbox relay ----------------------------------------------------------
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BASE_BACKOFF_MS=500

# ---- Reprocessador de pending-reference --------------------------------
PENDING_REFERENCE_POLL_INTERVAL_MS=5000
PENDING_REFERENCE_BATCH_SIZE=50
PENDING_REFERENCE_MAX_ATTEMPTS=12
PENDING_REFERENCE_TTL_HOURS=24
PENDING_REFERENCE_BASE_BACKOFF_MS=2000
