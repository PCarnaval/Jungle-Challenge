{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed financial processor for wagering transactions — Jungle Gaming technical challenge",
  "scripts": {
    "build": "nest build",
    "start": "bun run dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "start:api": "bun src/main.ts",
    "start:consumer": "WORKER=consumer bun src/main.ts",
    "start:outbox": "WORKER=outbox bun src/main.ts",
    "start:pending-reference": "WORKER=pending-reference bun src/main.ts",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "migration:fresh": "mikro-orm migration:fresh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:e2e": "bun test test/integration test/concurrency",
    "test:all": "bun test test/unit && bun test test/integration test/concurrency",
    "test:load": "bun run test/load/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1126.0",
    "@mikro-orm/core": "^6",
    "@mikro-orm/migrations": "^6",
    "@mikro-orm/nestjs": "^6",
    "@mikro-orm/postgresql": "^6",
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/terminus": "^11.0.0",
    "decimal.js": "^10.6.0",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6",
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "ajv": "^8",
    "eslint": "^10.9.1",
    "testcontainers": "^12.1.0",
    "typescript": "^5"
  },
  "mikro-orm": {
    "configPaths": ["./src/infrastructure/persistence/mikro-orm/mikro-orm.config.ts"]
  }
}
